#include <bits/stdc++.h>
using namespace std;
pair <int ,int> sarch2darrey(int arr[][2],int n,int m,int target){
    for(int r=0;r<n;r++){
        for(int c=0;c<m;c++){
            if (arr[r][c]==target){
                return {r,c};
            }
        }
    }return {-1,-1};
}
int main() {
int arr[3][2];
for(int i=0;i<3;i++){
    for(int j=0;j<2;j++){
        cin>>arr[i][j];
    }
}cout<<endl;
pair<int,int> ans=sarch2darrey(arr,3,2 ,7);
cout<<ans.first<<" "<<ans.second<<endl;
}
