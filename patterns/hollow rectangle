#include <bits/stdc++.h>
using namespace std;

int main() {
    for (int row = 1; row <= 7; row++) {
        if (row == 1 || row == 7) {
            for (int col = 1; col <= 5; col++) {
                cout << "9 ";
            }
        } else {
            cout << "+ ";
            for (int col = 1; col <= 5 - 2; col++) {
                cout << "  ";
            }
            cout << "* ";
        }
        cout << endl;
    }
}
