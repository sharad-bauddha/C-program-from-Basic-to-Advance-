#include <bits/stdc++.h>
using namespace std;

int main() {
    for (int row = 1; row <= 7; row++) {
        // Prints the leading spaces
        for (int col = 1; col <= 7 - row; col++) {
            cout << " ";
        }
        // Prints the stars
        for (int col = 1; col <= 2 * row - 1; col++) {
            cout << "*";
        } 
        cout << endl;
    }
    return 0;
}
