#include <bits/stdc++.h>
using namespace std;

int main() {
    int l = 0;
    int n;
    cin >> n;
    int original = n;

    while (n != 0) {
        int d = n % 10;
        l = l * 10 + d;
        n = n / 10;
    }
    
    cout << l << " ";
    
    if (original == l) {
        cout << "palindrome" << endl;
    } else {
        cout << "not a palindrome" << endl;
    }
    
    return 0;
}
