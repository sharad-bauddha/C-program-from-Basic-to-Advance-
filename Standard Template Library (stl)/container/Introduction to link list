                           Swapping ,insertion,clear





int main() { 
    list<int> l1;
    list<int> l2;
   
    l1.push_back(2);
     l1.push_back(4);
      l1.push_back(6);
      l1.push_front(1);
     cout<<l1.size()<<endl;
        
      l1.insert(l1.begin(),19);
    //  l1.erase(l1.begin(),l1.end());
        l2.push_back(7);
        l2.push_back(9); 
        l2.push_back(90); 
        l2.push_back(19); 
        l2.insert(l2.end(),14);
        list<int>::iterator it1=l1.begin();
        while(it1!=l1.end()){
            cout<<*it1<<endl;
            it1++;
        }cout<<endl;
     l1.swap(l2);
     list<int>::iterator it=l1.begin();
        while(it!=l1.end()){
            cout<<*it<<endl;
            it++;
        }
}


