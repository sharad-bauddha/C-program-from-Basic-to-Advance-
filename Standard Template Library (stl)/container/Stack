#include <bits/stdc++.h>
#include <stack> 
using namespace std;

int main() { 

    stack<int> s;
    stack<int> u;
    s.push(3);
     s.push(2);
      s.push(5);
       s.push(7);
        s.push(9);
        s.pop();
    cout<<s.size()<<endl;
     u.push(23); 
      u.push(45);
       u.push(56);
        u.push(67);
         u.push(78);
         cout<<u.size()<<endl;
         cout<<u.top() <<";"<<endl;
    // cout<<u.base()<<endl;nosuch things
    if(u.empty()==true){
        cout<<"empty stack"<<endl;
        
    }else{ cout<<"filled stack"<<endl;}
    s.swap(u);
     cout<<u.top() <<";"<<endl;
    
}
