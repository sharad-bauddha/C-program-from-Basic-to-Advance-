class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
    
    vector<vector<int>> ans;
    sort(nums.begin(),nums.end());
        int n=nums.size();
        for(int i=0;i<n;i++){if(i>0&& nums[i]==nums[i-1]){continue;}
         for(int j=i+1;j<n;j++){if(j>i+1&& nums[j]==nums[j-1]){continue;}
         for(int k=j+1;k<n;k++){if(k>j+1&& nums[k]==nums[k-1]){continue;}
                
            
                
                int f=nums[i];
                int s=nums[k];
                 int t=nums[j];
                 int sum=f+s+t;
                 if(sum==0){
                 vector<int> yemp;
                 yemp.push_back(f);
                 yemp.push_back(s);
                 yemp.push_back(t);
                 ans.push_back(yemp);

                 }
            }
        }
        }
        return ans;
    }
};
